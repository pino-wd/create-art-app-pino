{
  "name": "<%= options.projectName %>",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "run-p type-check:app type-check:node",
    "type-check:app": "vue-tsc --noEmit -p tsconfig.app.json",
    "type-check:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"<% if (options.scaffold.docGovernance) { %>,
    "docs:lint": "node scripts/docs/lint-frontmatter.mjs && node scripts/docs/lint-naming.mjs && node scripts/docs/lint-no-private-path.mjs && node scripts/docs/lint-links.mjs"<% } %><% if (options.scaffold.commitChecks) { %>,
    "check:commit:fix": "lint-staged",
    "check:push": "<%= options.scaffold.docGovernance ? 'run-s lint type-check docs:lint' : 'run-s lint type-check' %>",
    "prepare": "husky"<% } %>
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2",
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.16.0",
    "echarts": "^6.0.0",
    "element-plus": "^2",
    "highlight.js": "^11.10.0",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.11",
    "pinia": "^3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3",
    "vue-i18n": "^11.4.2",
    "vue-router": "^4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6",
    "@tailwindcss/vite": "^4.1.14",
    "@tsconfig/node22": "^22",
    "@types/node": "^24",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6",
    "@vue/tsconfig": "^0.8",
    "eslint": "^9",
    "eslint-plugin-format": "^2.0.1",
<% if (options.scaffold.docGovernance) { %>    "gray-matter": "^4.0.3",
<% } %><% if (options.scaffold.commitChecks) { %>    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
<% } %>
    "npm-run-all2": "^8",
    "sass": "^1.81.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5",
    "unplugin-auto-import": "^20",
    "unplugin-element-plus": "^0.10.0",
    "unplugin-vue-components": "^30",
    "vite": "^7",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^3"
  }
}
